exports[`PromptInput — existing usage is unchanged > renders the same markup as 5.64.1 (inline paste) 1`] = `"<div data-react-fancy-prompt-input="" data-react-fancy-prompt-input-drag="idle" class="relative rounded-md border bg-[color:var(--fancy-surface,var(--color-white))] transition dark:bg-[color:var(--fancy-surface-dark,var(--color-zinc-900))] border-zinc-200 dark:border-zinc-800"><div class="relative"><div class="relative"><span aria-hidden="true" class="pointer-events-none absolute text-zinc-400 left-3 top-2.5 text-[14px] leading-relaxed">Ask anything. Type / for commands, @ for mentions. Ctrl+Enter to send.</span><div data-react-fancy-composer-input="" role="textbox" aria-multiline="true" aria-placeholder="Ask anything. Type / for commands, @ for mentions. Ctrl+Enter to send." contenteditable="true" style="max-height: 280px;" class="max-h-72 w-full overflow-y-auto whitespace-pre-wrap break-words bg-transparent outline-none block min-h-[5.5rem] px-3 py-2.5 text-[14px] leading-relaxed"></div></div></div><div class="flex items-center gap-2 border-t border-zinc-200 bg-zinc-50/60 px-3 py-2 dark:border-zinc-800 dark:bg-zinc-900/40"><button class="inline-flex items-center justify-center text-left font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-1 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg px-2 py-1 text-xs bg-transparent text-[color:var(--fancy-text-soft,var(--color-zinc-700))] hover:bg-[color:var(--fancy-surface-muted,var(--color-zinc-100))] dark:text-[color:var(--fancy-text-soft-dark,var(--color-zinc-300))] dark:hover:bg-[color:var(--fancy-surface-muted-dark,var(--color-zinc-800))] gap-2 shrink-0" data-react-fancy-button="" data-react-fancy-action="" data-react-fancy-prompt-input-attach=""><span data-action-icon="leading" class="inline-flex items-center flex-shrink-0 text-current"><span aria-hidden="true" data-react-fancy-icon="" class="inline-flex items-center justify-center flex-shrink-0 h-3 w-3"></span></span><span data-react-fancy-button-label="" class="min-w-0">attach</span></button><input multiple="" class="hidden" type="file"><div data-react-fancy-prompt-input-meter="" data-level="ok" class="ml-2 flex min-w-0 items-center gap-1.5 overflow-hidden"><div class="h-1.5 w-24 shrink overflow-hidden rounded-full bg-[color:var(--fancy-border,var(--color-zinc-200))] dark:bg-[color:var(--fancy-border-dark,var(--color-zinc-700))]"><div class="h-full rounded-full transition-all" style="width: 0%; background-color: rgb(16, 185, 129);"></div></div><span class="font-mono text-[11px]" style="color: rgb(16, 185, 129);">0 / 1.0k</span></div><div class="ml-auto flex shrink-0 items-center gap-2"><span class="hidden text-[10px] text-zinc-500 sm:inline" data-react-fancy-prompt-input-hint="generic"><kbd class="rounded border border-[color:var(--fancy-border-strong,var(--color-zinc-300))] bg-zinc-50 px-1 py-0.5 font-mono text-[9px] text-[color:var(--fancy-text-soft,var(--color-zinc-700))] dark:border-[color:var(--fancy-border-strong-dark,var(--color-zinc-700))] dark:bg-zinc-800 dark:text-[color:var(--fancy-text-soft-dark,var(--color-zinc-300))]">Ctrl</kbd> + <kbd class="rounded border border-[color:var(--fancy-border-strong,var(--color-zinc-300))] bg-zinc-50 px-1 py-0.5 font-mono text-[9px] text-[color:var(--fancy-text-soft,var(--color-zinc-700))] dark:border-[color:var(--fancy-border-strong-dark,var(--color-zinc-700))] dark:bg-zinc-800 dark:text-[color:var(--fancy-text-soft-dark,var(--color-zinc-300))]">Enter</kbd> to send</span><button class="inline-flex items-center justify-center text-left font-medium transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-1 disabled:opacity-50 disabled:cursor-not-allowed rounded-lg px-2 py-1 text-xs bg-violet-500 text-white border border-violet-600 hover:bg-violet-600 dark:bg-violet-600 dark:border-violet-500 dark:hover:bg-violet-500 gap-2 shrink-0" data-react-fancy-button="" data-react-fancy-action="" data-react-fancy-prompt-input-send=""><span data-react-fancy-button-label="" class="min-w-0">send</span><span data-action-icon="trailing" class="inline-flex items-center flex-shrink-0 text-current"><span aria-hidden="true" data-react-fancy-icon="" class="inline-flex items-center justify-center flex-shrink-0 h-3 w-3"></span></span></button></div></div></div>"`;

